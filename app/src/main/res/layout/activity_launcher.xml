<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="72dp"
        android:scrollbars="none" />

    <!-- Options side panel, shown with the Menu button or a long press. -->
    <FrameLayout
        android:id="@+id/options_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/options_panel"
            android:layout_width="@dimen/options_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/options_panel_bg"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="48dp"
            android:paddingEnd="32dp">

            <ImageView
                android:id="@+id/options_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/options_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/options_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/options_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
