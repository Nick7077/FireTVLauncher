<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="32dp"
    android:paddingEnd="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="44sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hidden_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/showing_hidden"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:visibility="gone" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:drawSelectorOnTop="true"
        android:horizontalSpacing="20dp"
        android:listSelector="@drawable/tile_selector"
        android:numColumns="5"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="24dp" />
</LinearLayout>
